module raygui @feat(ENABLE_RAYGUI);
import rl;

// Controls
extern fn int __gui_tab_bar(rl::Rectangle bounds, char** text, int count, int* active) @cname("GuiTabBar") @private;

// Basic controls set
extern fn int __gui_text_box(rl::Rectangle bounds, char* text, int text_size, bool edit_mode) @cname("GuiTextBox");

// Advance controls set
extern fn int __gui_list_view_ex(rl::Rectangle bounds, char** text, int count, int *scroll_index, int *active, int *focus) @cname("GuiListViewEx") @private;
extern fn int __gui_text_input_box(rl::Rectangle bounds, ZString title, ZString message, ZString buttons, char *text, int text_max_size, bool *secret_view_active) @cname("GuiTextInputBox") @private;


module rl;

//------------------------------------------------------------------------------------
// A functions will be used to their corresponding wrappers
//------------------------------------------------------------------------------------

// rcore.c3
//------------------------------------------------------------------------------------
extern fn void __set_window_icons(Image* images, int count) @cname("SetWindowIcons") @private;
extern fn int __get_shader_location(Shader shader, ZString uniform_name) @cname("GetShaderLocation") @private;
extern fn int __get_shader_location_attrib(Shader shader, ZString attrib_name) @cname("GetShaderLocationAttrib") @private;

module rl;

extern fn void __set_random_seed(uint seed) @cname("SetRandomSeed");
extern fn int __get_random_value(int min, int max) @cname("GetRandomValue") @private;
extern fn int* __load_random_sequence(uint count, int min, int max) @cname("LoadRandomSequence") @private;
extern fn void __unload_random_sequence(int* sequence) @cname("UnloadRandomSequence") @private;

module rl;

extern fn char* __load_file_data(ZString file_name, int* data_size) @cname("LoadFileData");
extern fn void __unload_file_data(char* data) @cname("UnloadFileData") @private;
extern fn bool __export_data_as_code(char* data, int data_size, ZString file_name) @cname("ExportDataAsCode") @private;
extern fn ZString __load_file_text(ZString file_name) @cname("LoadFileText") @private;

module rl;

extern fn char* __compress_data(char* data, int dataSize, int *comp_data_size) @cname("CompressData") @private;
extern fn char* __decompress_data(char* comp_data, int comp_data_size, int *data_size) @cname("DecompressData") @private;
extern fn char* __encode_data_base64(char* data, int data_size, int *outputSize) @cname("EncodeDataBase64") @private;
extern fn char* __decode_data_base64(char* data, int *output_size) @cname("DecodeDataBase64") @private;
//------------------------------------------------------------------------------------

// raudio.c3
//------------------------------------------------------------------------------------
extern fn Wave __load_wave_from_memory(ZString file_type, char* file_data, int data_size) @cname("LoadWaveFromMemory") @private;
//------------------------------------------------------------------------------------

// rmodels.c3
//------------------------------------------------------------------------------------
extern fn void __draw_triangle_strip3d(Vector3* points, int point_count, Color color) @cname("DrawTriangleStrip3D") @private;
extern fn void __draw_mesh_instanced(Mesh mesh, Material material, Matrix* transforms, int instances) @cname("DrawMeshInstanced");
extern fn Material* __load_materials(ZString file_name, int* material_count) @cname("LoadMaterials") @private;
extern fn ModelAnimation* __load_model_animations(ZString file_name, int *anim_count) @cname("LoadModelAnimations") @private;
extern fn void __unload_model_animations(ModelAnimation* animations, int anim_count) @cname("UnloadModelAnimations") @private;
//------------------------------------------------------------------------------------

// rshapes.c3
//------------------------------------------------------------------------------------
extern fn void __draw_line_strip(Vector2* points, int point_count, Color color) @cname("DrawLineStrip");
extern fn void __draw_triangle_fan(Vector2* points, int point_count, Color color) @cname("DrawTriangleFan") @private;
extern fn void __draw_triangle_strip(Vector2* points, int point_count, Color color) @cname("DrawTriangleStrip") @private;
extern fn void __draw_spline_linear(Vector2* points, int point_count, float thick, Color color) @cname("DrawSplineLinear") @private;
extern fn void __draw_spline_basis(Vector2* points, int point_count, float thick, Color color) @cname("DrawSplineBasis") @private;
extern fn void __draw_spline_catmull_rom(Vector2* points, int point_count, float thick, Color color) @cname("DrawSplineCatmullRom") @private;
extern fn void __draw_spline_bezier_quadratic(Vector2* points, int point_count, float thick, Color color) @cname("DrawSplineBezierQuadratic") @private;
extern fn void __draw_spline_bezier_cubic(Vector2* points, int point_count, float thick, Color color) @cname("DrawSplineBezierCubic") @private;
extern fn bool __check_collision_point_poly(Vector2 point, Vector2* points, int point_count) @cname("CheckCollisionPointPoly") @private;
//------------------------------------------------------------------------------------

// text.c3
//------------------------------------------------------------------------------------
extern fn void __unload_font_data(GlyphInfo* glyphs, int glyph_count) @cname("UnloadFontData");
//------------------------------------------------------------------------------------

// text.c3
//------------------------------------------------------------------------------------
extern fn char* __export_image_to_memory(Image image, ZString file_type, int *file_size) @cname("ExportImageToMemory") @private;
extern fn Color* __load_image_colors(Image image) @cname("LoadImageColors") @private;
extern fn Color* __load_image_palette(Image image, int max_palette_size, int *color_count) @cname("LoadImagePalette") @private;
extern fn void __unload_image_colors(Color* colors) @cname("UnloadImageColors") @private;
extern fn void __unload_image_palette(Color* colors) @cname("UnloadImagePalette") @private;
//------------------------------------------------------------------------------------

// rtextures.c3
//------------------------------------------------------------------------------------
extern fn void __image_draw_triangle_fan(Image* dst, Vector2* points, int point_count, Color color) @cname("ImageDrawTriangleFan");
extern fn void __image_draw_triangle_strip(Image* dst, Vector2* points, int point_count, Color color) @cname("ImageDrawTriangleStrip");
